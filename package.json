{
  "name": "phantom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sprites": "node scripts/extract-sprites.mjs",
    "tauri": "tauri",
    "installer:mac": "CI=true tauri build --bundles app,dmg && mkdir -p release/macos && cp src-tauri/target/release/bundle/dmg/*.dmg release/macos/",
    "installer:linux": "./scripts/build-linux.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "highlight.js": "^11.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "sharp": "^0.34.0",
    "typescript": "~5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
